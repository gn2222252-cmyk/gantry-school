; AOI sorter PLC program. Edit this file, then run: python build_ladder.py
; ';' = comment, ';;' = section title, ';#' = paragraph title.
; Device use: see AOI_PLC_說明.md

;; SECTION 1  I/O MAP (only this section changes for the school wiring)
;# Physical inputs
LD X000
OUT M0
LD X001
OUT M1
LD X002
OUT M2
LD X003
OUT M3
;# Sensor image M120-M135 = DI0-15, M136-M139 = DI16-19. Now fed by the machine simulation (M220-M236); replace LD M2xx with LD X0xx for a real sensor
LD M220
OUT M120
LD M221
OUT M121
LD M222
OUT M122
LD M223
OUT M123
LD M224
OUT M124
LD M225
OUT M125
LD M226
OUT M126
LD M227
OUT M127
LD M228
OUT M128
LD M229
OUT M129
LD M230
OUT M130
LD M231
OUT M131
LD M232
OUT M132
LD M233
OUT M133
LD M234
OUT M134
LD M235
OUT M135
LD M236
OUT M136
LD M0
OUT M137
LD M1
OUT M138
LD M2
OUT M139
;# Physical outputs: M100-M111 = DO0-11
LD M100
OUT Y000
LD M101
OUT Y001
LD M102
OUT Y002
LD M103
OUT Y003
LD M110
OUT Y004
LD M109
OUT Y005
LD M108
OUT Y006
LD M111
OUT Y007

;; SECTION 2  CONTROL
;# Power-up: clear working data, fill defaults when D530-D532 are 0
LD M8002
SET M198
MOV K0 D100
MOV K0 D510
MOV K0 D511
MOV K0 D550
MOV K10 D300
MOV K0 D301
MOV K0 D306
MOV K0 D310
MOV K0 D311
MOV K0 D312
MOV K0 D313
MOV K550 D314
MOV K0 D400
MOV K0 D401
MOV K0 D402
MOV K0 D403
MOV K1001 D25
LD M8002
AND= D530 K0
MOV K60 D530
LD M8002
AND= D531 K0
MOV K50 D531
LD M8002
AND= D532 K0
MOV K20 D532
;# Every scan: speed, fault bits, step timer T0 (restarts when the step changes)
LD M8000
MOV D530 D315
MOV D550 K2M190
CMP D300 D20 M150
MOV D300 D20
LD M151
OUT T0 K32767
;# Step flags M160-M173
LD= D300 K10
OUT M160
LD= D300 K20
OUT M161
LD= D300 K30
OUT M162
LD= D300 K40
OUT M163
LD= D300 K50
OUT M164
LD= D300 K60
OUT M165
LD= D300 K70
OUT M166
LD= D300 K80
OUT M167
LD= D300 K90
OUT M168
LD= D300 K100
OUT M169
LD= D300 K110
OUT M170
LD= D300 K120
OUT M171
LD= D300 K900
OUT M172
LD= D300 K910
OUT M173
;# b1 running (steps 40-120), emergency stop M192 = X3 open or D550 bit0
LD>= D300 K40
AND<= D300 K120
OUT M141
LDI M3
OR M190
OUT M192
LD M192
OUT M145
LD M134
OUT M144
;# Commands: button edge OR D100, then D100 goes back to 0
LD M0
PLS M4
LD M1
PLS M5
LD M2
PLS M6
LD= D100 K1
OR M4
OUT M10
LD= D100 K2
OR M5
OUT M11
LD= D100 K3
OR M6
OUT M12
LD= D100 K4
OUT M13
LD= D100 K5
OUT M14
LD M8000
MOV K0 D100
;# Stop request M21 (b3): finish this part, then Idle
LD M11
AND M141
SET M21
LD M162
OR M172
RST M21
LD M21
OUT M143
;# NG bin commands
LD M13
MOV K0 D313
LD M14
MOV D532 D313
;# Step 10 Init: all cylinders off, wait for retract and safety
LD M160
RST M101
RST M102
RST M103
RST M106
RST M140
LD M160
AND M131
AND M133
ANI M192
AND M123
MOV K20 D300
;# Step 20 Purge: belt 6 s with the stopper down
LD M161
AND>= T0 K60
MOV K30 D300
;# Step 30 Idle: wait for start
LD M162
AND M10
ANI M134
AND= D301 K0
MOV K40 D300
;# Step 40 RequestPart: DO4 pulse 0.3 s, wait for entry sensor
LD M163
AND< T0 K3
ANI M192
OUT M104
LD M163
AND M124
MOV K50 D300
;# Step 50 ToStopper: stopper up, belt runs
LD M164
SET M101
LD M164
AND M125
MOV K60 D300
;# Step 60 Clamp: belt stops, clamp extends
LD M165
SET M102
LD M165
AND M130
MOV K70 D300
;# Step 70 Inspect: light on, D306 = id, b0 only after D511 = 0 (handshake item 5)
LD M166
SET M106
MOV D401 D306
LD M166
AND= D511 K0
SET M140
LD M166
AND M140
AND= D511 K1
OUT M22
LD M22
LD= D510 K1
OR= D510 K2
ANB
OUT M23
LD M23
MOV D510 D403
RST M140
MOV K80 D300
LD M22
AND= D510 K3
OUT M28
LD M22
ANI M23
ANI M28
OUT M24
;# Step 80 Release: light off, clamp and stopper back
LD M167
RST M106
RST M102
RST M101
LD M167
AND M131
AND M129
MOV K90 D300
;# Step 90 ToSort: belt until sort sensor, NG goes to 100, OK to 110
LD M168
AND M126
AND= D403 K2
MOV K100 D300
LD M168
AND M126
AND= D403 K1
MOV K110 D300
;# Step 100 PushNG: pusher out, back when extended, leave when retracted
LD M169
ANI M151
SET M103
LD M169
AND M132
RST M103
LD M169
AND M151
AND M133
ANI M103
MOV K120 D300
;# Step 110 ToExit: belt and offer until the exit sensor turned on and off again
LD M170
AND M127
SET M25
LD M170
AND M25
ANI M127
MOV K120 D300
;# Step 120 Done: count once, then choose the next step
LD M171
RST M25
INC D310
LD M171
AND= D403 K1
INC D311
LD M171
AND= D403 K2
INC D312
LD M171
AND M21
MOV K30 D300
LD M171
ANI M21
ANI M134
MOV K40 D300
LD M171
ANI M21
AND M134
OUT M26
;# Step 900 Error: end the inspection request, go to AlarmWait
LD M172
RST M140
MOV K910 D300
;# Step 910 AlarmWait: reset works only when the cause is gone (M27 off)
LD M173
AND M12
ANI M27
MOV K0 D301
MOV K10 D300
;# Outputs made from steps
LD M161
OR M164
OR M168
OR M170
ANI M192
OUT M100
LD M161
OR M170
ANI M192
OUT M105
LD M141
ANI M192
OUT M110
LD M162
ANI M192
OUT M109
LD M172
OR M173
ANI M192
OUT M108
OUT M111
;# Emergency stop: every held output off at once
LD M192
RST M101
RST M102
RST M103
RST M106

;; SECTION 3  ALARMS (only the first code is kept: each rung checks D301 = 0)
;# Heartbeat: T1 runs in steps 40-120, T2 always (used to know the cause is gone)
LD M8000
CMP D520 D22 M153
MOV D520 D22
LD M154
AND M141
OUT T1 K20
LD M154
OUT T2 K20
;# 8001 emergency stop
LD M192
AND= D301 K0
MOV K8001 D301
;# 8004 low air
LD< D314 K450
AND= D301 K0
MOV K8004 D301
;# 8101 NG bin full (after Done, or Start while full)
LD M162
AND M10
AND M134
OR M26
AND= D301 K0
MOV K8101 D301
;# 9002 / 9003 / 9001 cylinder timeouts
LD M160
AND>= T0 K20
ANI M131
AND= D301 K0
MOV K9002 D301
LD M160
AND>= T0 K20
ANI M133
AND= D301 K0
MOV K9003 D301
LD M165
AND>= T0 K10
ANI M130
AND= D301 K0
MOV K9002 D301
LD M167
AND>= T0 K10
ANI M131
AND= D301 K0
MOV K9002 D301
LD M167
AND>= T0 K10
ANI M129
AND= D301 K0
MOV K9001 D301
LD M169
AND>= T0 K10
AND= D301 K0
MOV K9003 D301
;# 9004 part did not arrive: step 40 5 s, 50 6 s, 90 4 s, 110 4 s
LD M163
AND>= T0 K50
LD M164
AND>= T0 K60
ORB
LD M168
AND>= T0 K40
ORB
LD M170
AND>= T0 K40
ORB
AND= D301 K0
MOV K9004 D301
;# 9005 inspection timeout (D531 x 0.1 s)
LD M166
AND>= T0 D531
AND= D301 K0
MOV K9005 D301
;# 9006 heartbeat timeout
LD T1
AND= D301 K0
MOV K9006 D301
;# 9007 illegal inspection result
LD M24
AND= D301 K0
MOV K9007 D301
;# 9008 servo alarm reported by the host (D510 = 3)
LD M28
AND= D301 K0
MOV K9008 D301
;# Any alarm sends the machine to step 900
LD> D301 K0
AND< D300 K900
MOV K900 D300
LD> D301 K0
OUT M142
;# M27 = alarm cause still present
LD M192
OR< D314 K450
LD= D301 K8101
AND M134
ORB
LD= D301 K9002
AND M191
ORB
LD= D301 K9006
AND T2
ORB
OUT M27

;; SECTION 4  MACHINE SIMULATION (M198 OFF switches the whole section off)
;# 100 ms tick, belt travel D32 = speed x 2.5 (x5, then shift right one bit through K4M250)
LD M8012
PLS M240
LD M198
ADD D315 D315 D30
ADD D30 D30 D31
ADD D31 D315 D31
MOV D31 K4M250
MOV K4M251 D32
;# New part 0.3 s after the request pulse starts (falling edge of DO4)
LD M104
PLF M242
LD M242
AND M198
AND M135
MOV K1 D400
MOV D25 D401
MOV K0 D402
MOV K0 D403
INC D25
;# Part position
LD M240
AND M198
AND M100
ANI M192
ANI M102
AND= D400 K1
ADD D402 D32 D402
LD M198
AND M101
AND>= D402 K4000
MOV K4000 D402
LD M198
AND>= D402 K9000
MOV K9000 D402
;# Safety and belt sensors
LD M198
ANI M192
OUT M220
LD M198
OUT M221
OUT M222
OUT M235
OUT M236
LD M198
AND>= D314 K450
OUT M223
LD M198
AND= D400 K1
AND>= D402 K0
AND<= D402 K400
OUT M224
LD M198
AND= D400 K1
AND>= D402 K3950
AND<= D402 K4050
OUT M225
LD M198
AND= D400 K1
AND>= D402 K6850
AND<= D402 K7150
OUT M226
LD M198
AND= D400 K1
AND>= D402 K8900
OUT M227
;# Cylinders: stopper 0.2 s, clamp 0.3 s, pusher 0.3 s. D550 bit1 blocks the clamp extended sensor
LD M198
AND M101
OUT T10 K2
LD M198
ANI M101
OUT T11 K2
LD M198
AND M102
OUT T12 K3
LD M198
ANI M102
OUT T13 K3
LD M198
AND M103
OUT T14 K3
LD M198
ANI M103
OUT T15 K3
LD T10
OUT M228
LD T11
OUT M229
LD T12
ANI M191
OUT M230
LD T13
OUT M231
LD T14
OUT M232
LD T15
OUT M233
;# Push: part in 6750-7250 goes into the NG bin
LD M132
PLS M241
LD M241
AND M198
AND= D400 K1
AND>= D402 K6750
AND<= D402 K7250
MOV K0 D400
INC D313
;# Exit: at the exit with offer ON for 0.5 s, the part is taken
LD M198
AND M127
AND M105
AND M136
OUT T16 K5
LD T16
MOV K0 D400
MOV K0 D402
;# NG bin full
LD M198
AND>= D313 D532
OUT M234

;; SECTION 5  WORDS FOR LABVIEW
LD M8000
MOV K2M140 D302
MOV K4M120 D303
MOV K1M136 D304
MOV K4M100 D305
END
